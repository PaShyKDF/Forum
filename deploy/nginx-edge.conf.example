# Пример edge nginx на VPS: один домен → frontend + Keycloak (/auth).
# Скопируйте в /etc/nginx/sites-available/ и подставьте свой домен/порты.
#
# Порты из .env:
#   FORUM_FRONTEND_HOST_PORT (часто 3080)
#   FORUM_KC_HOST_PORT (часто 8282)
# Path Keycloak: FORUM_KC_HTTP_RELATIVE_PATH=/auth

upstream forum_frontend {
    server 127.0.0.1:3080;
    keepalive 32;
}

upstream forum_keycloak {
    server 127.0.0.1:8282;
    keepalive 16;
}

server {
    server_name example.com;

    # Keycloak (KC_HTTP_RELATIVE_PATH=/auth)
    # proxy_pass без URI — путь /auth/... уходит в контейнер как есть
    location /auth/ {
        proxy_pass http://forum_keycloak;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Frontend nginx (проксирует /api → api)
    location / {
        proxy_pass http://forum_frontend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl;
    # ssl_* — certbot
}

server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}
