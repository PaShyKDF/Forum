# Режим работы
FORUM_MODE=DEV
FORUM_ENVIRONMENT=development
FORUM_ENABLE_ADMIN_AUTH=true

# SQLAdmin через Keycloak (роль FORUM_ADMIN_ROLE в access token)
FORUM_ADMIN_AUTH_SECRET_KEY=change-me-forum-admin-secret
FORUM_ADMIN_ROLE=admin

# Основная база данных
FORUM_DB_SYSTEM=postgresql
FORUM_DB_DRIVER=asyncpg
FORUM_DB_DATABASE=forum
FORUM_DB_USER=postgres
FORUM_DB_PASSWORD=postgres
FORUM_DB_HOST=db
FORUM_DB_POOL_SIZE=5
FORUM_DB_MAX_OVERFLOW=10
FORUM_DB_HOST_PORT=5433
FORUM_DB_CONTAINER_PORT=5432

# Тестовая база данных
FORUM_TEST_DB_SYSTEM=postgresql
FORUM_TEST_DB_DRIVER=asyncpg
FORUM_TEST_DB_HOST=127.0.0.1
FORUM_TEST_DB_POOL_SIZE=5
FORUM_TEST_DB_MAX_OVERFLOW=10
FORUM_TEST_DB_DATABASE=forum_test
FORUM_TEST_DB_USER=postgres
FORUM_TEST_DB_PASSWORD=postgres
FORUM_TEST_DB_HOST_PORT=5434
FORUM_TEST_DB_CONTAINER_PORT=5432

# Redis
FORUM_REDIS_CACHE_HOST=redis
FORUM_REDIS_CACHE_HOST_PORT=6380
FORUM_REDIS_CACHE_CONTAINER_PORT=6379
FORUM_REDIS_CACHE_PASSWORD=forum_redis_password
FORUM_REDIS_CACHE_DB=0
FORUM_REDIS_CACHE_TTL_STATE=600
FORUM_REDIS_CACHE_TTL_DATA=3600
FORUM_REDIS_TASKIQ_DB=5

# FastAPI / Gunicorn
FORUM_FASTAPI_BIND_ADDRESS=0.0.0.0
FORUM_FASTAPI_HOST_PORT=8000
FORUM_FASTAPI_CONTAINER_PORT=8000
FORUM_GUNICORN_WORKER_COUNT=2
FORUM_BASE_URL=https://fastapikeycloack-yakvenalex.amvera.io

# Frontend (nginx) + CORS
# Синхронизируйте порт API с frontend/src/config.js
FORUM_FRONTEND_HOST_PORT=3080
FORUM_FRONTEND_URL=http://localhost:3080
FORUM_CORS_ORIGINS=http://localhost:3080,http://127.0.0.1:3080

# PGAdmin
FORUM_PGADMIN_HOST_PORT=5050
FORUM_PGADMIN_CONTAINER_PORT=80

# Логирование
FORUM_DEFAULT_LOG_LEVEL=DEBUG
FORUM_LOCAL_LOG_LEVEL=DEBUG
FORUM_EXTERNAL_LOG_LEVEL=WARNING
FORUM_SENTRY_DSN=

# KEYCLOAK DB
FORUM_KC_POSTGRES_USER=postgres
FORUM_KC_POSTGRES_PASSWORD=postgres
FORUM_KC_POSTGRES_DATABASE=postgres
FORUM_KC_POSTGRES_HOST_PORT=5454
FORUM_KC_POSTGRES_CONTAINER_PORT=5432

# KEYCLOAK
FORUM_KC_ADMIN_LOGIN=admin
FORUM_KC_ADMIN_PASSWORD=admin
# Порт публикации контейнера на хосте (edge nginx → 127.0.0.1:этот порт)
FORUM_KC_HOST_PORT=8282
FORUM_KC_CONTAINER_PORT=8080
# Hostname без схемы (локально: localhost; prod: example.com)
FORUM_KC_HOSTNAME=localhost
# Порт в публичных URL Keycloak.
# Local: 8282. Prod за HTTPS на 443: не задавайте переменную
# (или не прокидывайте KC_HOSTNAME_PORT в compose).
FORUM_KC_HOSTNAME_PORT=8282
# HTTP relative path: / = корень (local); /auth = один домен (prod).
# Не оставляйте пустым — Keycloak падает на "".
FORUM_KC_HTTP_RELATIVE_PATH=/

# KEYCLOAK CONNECT
# Браузер → Keycloak (публичный URL, со схемой и path)
# Dev:  http://localhost:8282
# Prod: https://example.com/auth
FORUM_KEYCLOAK_BASE_URL=http://localhost:8282
# API → Keycloak внутри Docker
# Dev:  http://host.docker.internal:8282
# Prod: http://keycloak:8080/auth  (path = FORUM_KC_HTTP_RELATIVE_PATH)
FORUM_KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8282
FORUM_KEYCLOAK_REALM=Forum
FORUM_KEYCLOAK_CLIENT_ID=forum_fastapi_client
FORUM_KEYCLOAK_CLIENT_SECRET=change-me
FORUM_KEYCLOAK_DEFAULT_ROLE=user

# Production Docker (split app / idp)
# Создать один раз: docker network create forum_public_net
FORUM_DOCKER_NETWORK=forum_public_net

# Обсуждения
# Сколько часов автор может редактировать своё сообщение
FORUM_POST_EDIT_WINDOW_HOURS=24
# Сколько часов автор может редактировать название темы
FORUM_TOPIC_EDIT_WINDOW_HOURS=24
# Размер страницы корневых сообщений темы
FORUM_POSTS_ROOTS_PAGE_SIZE=20
# Размер страницы ответов под сообщением
FORUM_POSTS_REPLIES_PAGE_SIZE=10
# Антиспам: мин. интервал между сообщениями (сек)
FORUM_MESSAGE_MIN_INTERVAL_SECONDS=10
# Антиспам: макс. сообщений в час
FORUM_POSTS_PER_HOUR_LIMIT=30
# Антиспам: окно для лимита новых тем (сек)
FORUM_TOPICS_WINDOW_SECONDS=600
# Антиспам: макс. новых тем в окне
FORUM_TOPICS_PER_WINDOW_LIMIT=3
# Антиспам: макс. новых тем в сутки (МСК)
FORUM_TOPICS_PER_DAY_LIMIT=10

# Страница «Связаться»
FORUM_CONTACT_TELEGRAM_URL=https://t.me/example
FORUM_CONTACT_WHATSAPP_URL=https://wa.me/79000000000

# Техподдержка
FORUM_SUPPORT_TICKETS_PER_DAY_LIMIT=2

# Трекинг гостей
FORUM_VISITOR_TOUCH_INTERVAL_SECONDS=300
FORUM_VISITOR_ANON_COOKIE_MAX_AGE=31536000
# Local Docker: вместо 172.x писать публичный egress IP (по умолчанию в DEV)
# FORUM_VISITORS_USE_EGRESS_IP_WHEN_PRIVATE=true
# Очистка устаревших гостей (TaskIQ, cron в UTC)
FORUM_VISITORS_CLEANUP_ENABLED=true
FORUM_VISITORS_CLEANUP_RETENTION_DAYS=7
# 0 0 * * * = 00:00 UTC = 03:00 МСК
FORUM_VISITORS_CLEANUP_CRON=0 0 * * *
FORUM_VISITORS_CLEANUP_BATCH_SIZE=500
FORUM_VISITORS_CLEANUP_MAX_BATCHES=1000

# Очистка неактивных уведомлений (TaskIQ)
FORUM_NOTIFICATIONS_CLEANUP_ENABLED=true
FORUM_NOTIFICATIONS_CLEANUP_BATCH_SIZE=500
FORUM_NOTIFICATIONS_CLEANUP_MAX_BATCHES=1000
# Cron в UTC (0 3 * * * = 03:00 UTC)
FORUM_NOTIFICATIONS_CLEANUP_CRON=0 3 * * *
